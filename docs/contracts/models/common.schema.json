{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/common.schema.json",
  "title": "PocketTally Common Models",
  "description": "Reusable scalar and embedded read-model definitions for PocketTally HTTP APIs.",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "transactionType": {
      "type": "string",
      "enum": ["income", "expense", "transfer", "balance_adjustment"]
    },
    "accountType": {
      "type": "string",
      "enum": ["debit", "credit"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "examples": ["#ff0000"]
    },
    "accountSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/accountType" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "categorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "iconColor", "iconName"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "iconColor": { "$ref": "#/$defs/hexColor" },
        "iconName": { "type": "string", "minLength": 1 }
      }
    },
    "tagSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/hexColor" }
      }
    },
    "transactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "amount", "description", "occurredAt", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/transactionType" },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "CNY 金额；服务端内部以整数分存储。"
        },
        "description": { "$ref": "#/$defs/nullableString" },
        "occurredAt": { "$ref": "#/$defs/dateTime" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
