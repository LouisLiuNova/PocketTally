{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/transaction.update.schema.json",
  "title": "TransactionUpdate",
  "description": "Partial payload for updating a transaction. Relationships are represented by IDs.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "type": { "$ref": "common.schema.json#/$defs/basicTransactionType" },
    "sourceAccountId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "destinationAccountId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "CNY 金额；按 ROUND_HALF_UP 舍入到分后必须仍为正数。"
    },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "categoryId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ],
      "description": "PATCH 合并完整状态后，普通收入和支出必填；转账和余额调整必须为空。"
    },
    "tagIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/uuid" },
      "uniqueItems": true
    },
    "balanceAdjustmentDirection": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/balanceAdjustmentDirection" },
        { "type": "null" }
      ],
      "description": "余额调整必须指定 increase 或 decrease；其他交易必须为空。"
    },
    "occurredAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
