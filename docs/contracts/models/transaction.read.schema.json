{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/transaction.read.schema.json",
  "title": "TransactionRead",
  "description": "Transaction returned by the HTTP API. Relationships are embedded as bounded read summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "sourceAccount", "destinationAccount", "amount", "description", "category", "tags", "refundOfTransactionId", "refundOfTransaction", "balanceAdjustmentDirection", "isVoid", "voidedAt", "occurredAt", "createdAt", "updatedAt"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "type": { "$ref": "common.schema.json#/$defs/transactionType" },
    "sourceAccount": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/accountSummary" },
        { "type": "null" }
      ]
    },
    "destinationAccount": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/accountSummary" },
        { "type": "null" }
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "CNY 金额；服务端内部以整数分存储。"
    },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "category": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/categorySummary" },
        { "type": "null" }
      ]
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/tagSummary" },
      "uniqueItems": true
    },
    "refundOfTransactionId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "refundOfTransaction": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/transactionSummary" },
        { "type": "null" }
      ]
    },
    "balanceAdjustmentDirection": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/balanceAdjustmentDirection" },
        { "type": "null" }
      ]
    },
    "isVoid": { "type": "boolean" },
    "voidedAt": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "occurredAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
