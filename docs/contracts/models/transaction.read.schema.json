{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/transaction.read.schema.json",
  "title": "TransactionRead",
  "description": "Transaction returned by the HTTP API. Relationships are embedded as bounded read summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "sourceAccount", "destinationAccount", "amount", "description", "category", "tags", "isRefund", "relatedTransaction", "occurredAt", "createdAt", "updatedAt"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "type": { "$ref": "common.schema.json#/$defs/transactionType" },
    "sourceAccount": { "$ref": "common.schema.json#/$defs/accountSummary" },
    "destinationAccount": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/accountSummary" },
        { "type": "null" }
      ]
    },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "category": { "$ref": "common.schema.json#/$defs/categorySummary" },
    "tags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/tagSummary" },
      "uniqueItems": true
    },
    "isRefund": { "type": "boolean" },
    "relatedTransaction": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/transactionSummary" },
        { "type": "null" }
      ]
    },
    "occurredAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
