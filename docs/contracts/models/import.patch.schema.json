{
  "$defs": {
    "ImportChange": {
      "additionalProperties": false,
      "properties": {
        "rowIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Rowids",
          "type": "array"
        },
        "paymentKey": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paymentkey"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "income",
                "expense"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "accountId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accountid"
        },
        "categoryId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Categoryid"
        },
        "included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Included"
        },
        "amountMinor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amountminor"
        },
        "occurredAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurredat"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "matchType": {
          "anyOf": [
            {
              "enum": [
                "income",
                "expense"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matchtype"
        },
        "rememberMapping": {
          "default": false,
          "title": "Remembermapping",
          "type": "boolean"
        }
      },
      "title": "ImportChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/ImportChange"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    }
  },
  "required": [
    "version",
    "changes"
  ],
  "title": "ImportPatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
