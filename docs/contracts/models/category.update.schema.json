{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/category.update.schema.json",
  "title": "CategoryUpdate",
  "description": "Partial payload for updating a category. Purpose is immutable. Moving a node with children requires explicit confirmation.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "parentCategoryId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "iconColor": { "$ref": "common.schema.json#/$defs/hexColor" },
    "iconName": { "type": "string", "minLength": 1 },
    "confirmSubtreeMove": {
      "type": "boolean",
      "description": "Must be true when changing the parent of a category that has descendants."
    }
  }
}
