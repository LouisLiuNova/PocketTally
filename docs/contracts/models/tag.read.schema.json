{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/tag.read.schema.json",
  "title": "TagRead",
  "description": "Tag returned by the HTTP API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "color", "createdAt", "updatedAt"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "color": { "$ref": "common.schema.json#/$defs/hexColor" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
