{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/transaction.create.schema.json",
  "title": "TransactionCreate",
  "description": "Payload for creating a transaction. Relationships are represented by IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "amount", "occurredAt"],
  "oneOf": [
    {
      "title": "IncomeTransactionCreate",
      "required": ["destinationAccountId", "categoryId"],
      "properties": {
        "type": { "const": "income" },
        "sourceAccountId": { "type": "null" },
        "destinationAccountId": { "$ref": "common.schema.json#/$defs/uuid" },
        "categoryId": { "$ref": "common.schema.json#/$defs/uuid" },
        "balanceAdjustmentDirection": { "type": "null" }
      }
    },
    {
      "title": "ExpenseTransactionCreate",
      "required": ["sourceAccountId", "categoryId"],
      "properties": {
        "type": { "const": "expense" },
        "sourceAccountId": { "$ref": "common.schema.json#/$defs/uuid" },
        "destinationAccountId": { "type": "null" },
        "categoryId": { "$ref": "common.schema.json#/$defs/uuid" },
        "balanceAdjustmentDirection": { "type": "null" }
      }
    },
    {
      "title": "TransferTransactionCreate",
      "required": ["sourceAccountId", "destinationAccountId"],
      "properties": {
        "type": { "const": "transfer" },
        "sourceAccountId": { "$ref": "common.schema.json#/$defs/uuid" },
        "destinationAccountId": { "$ref": "common.schema.json#/$defs/uuid" },
        "categoryId": { "type": "null" },
        "balanceAdjustmentDirection": { "type": "null" }
      }
    },
    {
      "title": "BalanceAdjustmentTransactionCreate",
      "required": ["sourceAccountId", "balanceAdjustmentDirection"],
      "properties": {
        "type": { "const": "balance_adjustment" },
        "sourceAccountId": { "$ref": "common.schema.json#/$defs/uuid" },
        "destinationAccountId": { "type": "null" },
        "categoryId": { "type": "null" },
        "balanceAdjustmentDirection": {
          "$ref": "common.schema.json#/$defs/balanceAdjustmentDirection"
        }
      }
    }
  ],
  "properties": {
    "type": { "$ref": "common.schema.json#/$defs/transactionType" },
    "sourceAccountId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "destinationAccountId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "CNY 金额；按 ROUND_HALF_UP 舍入到分后必须仍为正数。"
    },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "categoryId": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ],
      "description": "普通收入和支出必填；转账和余额调整必须为空。"
    },
    "tagIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/uuid" },
      "uniqueItems": true,
      "default": []
    },
    "balanceAdjustmentDirection": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/balanceAdjustmentDirection" },
        { "type": "null" }
      ],
      "description": "余额调整必须指定 increase 或 decrease；其他交易必须为空。"
    },
    "occurredAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
