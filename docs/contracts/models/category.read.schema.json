{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pockettally.app/models/category.read.schema.json",
  "title": "CategoryRead",
  "description": "Category returned by the HTTP API. The parent is embedded as a bounded summary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "purpose", "description", "parentCategory", "iconColor", "iconName", "createdAt", "updatedAt"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "$ref": "common.schema.json#/$defs/categoryPurpose" },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "parentCategory": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/categorySummary" },
        { "type": "null" }
      ]
    },
    "iconColor": { "$ref": "common.schema.json#/$defs/hexColor" },
    "iconName": { "type": "string", "minLength": 1 },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
