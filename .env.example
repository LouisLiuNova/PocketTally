# Compose 默认从 GHCR 拉取 v0.1.0；源码构建请使用 docker compose up -d --build。
POCKET_TALLY_BACKEND_IMAGE=ghcr.io/louisliunova/pockettally-backend
POCKET_TALLY_FRONTEND_IMAGE=ghcr.io/louisliunova/pockettally-frontend
POCKET_TALLY_IMAGE_TAG=0.1.0
POCKET_TALLY_APP_VERSION=0.1.0
POCKET_TALLY_VCS_REF=local

# 54425 是高位端口，不是安全措施。当前版本只能在可信内网使用。
POCKET_TALLY_BIND_ADDRESS=0.0.0.0
POCKET_TALLY_HTTP_PORT=54425

# Linux 可设为 id -u / id -g 的结果；macOS Docker Desktop 可保留默认值。
POCKET_TALLY_UID=10001
POCKET_TALLY_GID=10001
POCKET_TALLY_DATA_DIR=./data
POCKET_TALLY_BACKUP_DIR=./backups
POCKET_TALLY_LOG_LEVEL=INFO
